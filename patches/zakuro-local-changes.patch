+/// a battle's panels drawn anew over the top screen, top in points: for
+/// each fighter in the bottom corner on its side, each shape with a faint
+/// grain of noise, its name on a banner, its
+/// HP in a diamond by a long bar as full as its gauge, its weapon on a band,
+/// and Atk, Hit and Crit, in that order on both sides, as tabs over boxes,
+/// each shape in the colour of the ground its text lies on in the game, the
+/// text off that ground; the measures are a 1080-high window's at 85%.
+pub fn banners(ctx: &egui::Context, textures: &mut BannerTextures, read: &crate::banners::Read, top: egui::Rect, opacity: f32) {
+    let painter = ctx.layer_painter(egui::LayerId::background());
+    let opacity = opacity.clamp(0.0, 1.0);
