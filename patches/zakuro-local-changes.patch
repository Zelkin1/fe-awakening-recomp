+pub const MENU_KEEP: [Box4; 2] = [[170, 0, 256, 26], [170, 40, 256, 67]];
+pub const COPYRIGHT_BOX: Box4 = [0, 0, 512, 32];
+pub const GMAP_BUTTONS: [(Box4, usize, Ink); 8] = [
+    ([147, 11, 181, 30], 0, Ink::Dark),
+    ([186, 21, 221, 34], 1, Ink::Light),
