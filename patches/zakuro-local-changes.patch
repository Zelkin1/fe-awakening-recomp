+/// the draws few enough vertices to be a picture put on the screen, a quad.
+const BLIT_VERTICES: u32 = 6;
+
+/// the draws with more vertices than this are no marker, see Marker.
+const MARKER_VERTICES: u32 = 64;
+
+/// a draw a game makes on the top screen that marks something, the window
+/// it shows while its cursor is on a unit say, which Zakuro looks out for:
+/// what it marks, a number of the caller's, the value of texture unit 0's
+/// format register and its size, then the FNV-1a hash of its largest size's
+/// bytes when the texture is the same wherever and however the game runs,
+/// and where on the screen the draw lands when its place tells it apart.
+/// a draw without a texture, a shade laid over the screen say, has
+/// UNTEXTURED for its format, its size and hash going unread. bottom says
+/// the draw is on the bottom screen's buffer, 240 by 320, rather than the
+/// top one's.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Marker {
+    pub id: u32,
+    pub format: u32,
+    pub width: u32,
+    pub height: u32,
+    pub hash: Option<u64>,
+    pub place: Option<Place>,
+    pub bottom: bool,
+}
+
+impl Marker {
+    pub const UNTEXTURED: u32 = u32::MAX;
+
+    /// whether the draw's texture unit 0, its format and size, or its having
+    /// none, is this marker's.
+    fn fits(&self, registers: &[u32]) -> bool {
+        if registers[REG_TEXTURE_CONFIG] & 1 == 0 {
+            return self.format == Self::UNTEXTURED;
+        }
+        let dimensions = registers[REG_TEXTURE0_DIMENSIONS];
+        let (height, width) = (dimensions & 0x7FF, (dimensions >> 16) & 0x7FF);
+        self.format == registers[REG_TEXTURE0_FORMAT] & 0xF && self.width == width && self.height == height
+    }
+}
+
+/// where on the top screen a marker's draw lands: the ranges, from and to,
+/// its left edge, its top, its width and its height fall in, as fractions
+/// of the screen's width and height from its top left.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Place {
+    pub left: [f32; 2],
+    pub top: [f32; 2],
+    pub width: [f32; 2],
+    pub height: [f32; 2],
+}
+
+/// whether texture unit 0 has a texture of some marker's format and size,
+/// the cheap first test of a draw for a marker, see marker_drawn.
+fn marker_sized(registers: &[u32], markers: &[Marker]) -> bool {
+    markers.iter().any(|marker| marker.fits(registers))
+}
+
+/// the marker a draw on the top screen's buffer, 240 wide and 400 tall, is:
+/// one with its texture on unit 0, and with its vertices, shaded, where it
+/// has to be. the buffer is turned, the screen's x runs down the viewport's
+/// y from its top and its y down the viewport's x from its right.
+fn marker_drawn<M: GpuMemory>(registers: &[u32], memory: &mut M, markers: &[Marker], shaded: Option<&[Vertex]>, viewport: (f32, f32, f32, f32)) -> Option<(u32, Option<[f32; 4]>)> {
+    let (x, y, width, height) = viewport;
+    // the buffer of the screen the marker is on
+    let on_screen = |marker: &Marker| (width - 240.0).abs() <= 0.5 && (height - if marker.bottom { 320.0 } else { 400.0 }).abs() <= 0.5;
+    if !markers.iter().any(|marker| on_screen(marker) && marker.fits(registers)) {
+        return None;
+    }
+    let dimensions = registers[REG_TEXTURE0_DIMENSIONS];
+    let (texture_height, texture_width) = (dimensions & 0x7FF, (dimensions >> 16) & 0x7FF);
+    let format = registers[REG_TEXTURE0_FORMAT] & 0xF;
+    // what the screen shows of the vertices, left, top, right and bottom
+    let span = shaded.and_then(|shaded| {
+        shaded.iter().filter_map(|vertex| to_screen(vertex, viewport)).fold(None, |span: Option<[f32; 4]>, screen| {
+            let (across, down) = (1.0 - (screen.y - y) / height, 1.0 - (screen.x - x) / width);
+            let [left, top, right, bottom] = span.unwrap_or([across, down, across, down]);
+            Some([left.min(across), top.min(down), right.max(across), bottom.max(down)])
+        })
+    });
+    let mut hash = None;
+    for marker in markers.iter().filter(|marker| on_screen(marker) && marker.fits(registers)) {
+        if let Some(wanted) = marker.hash.filter(|_| marker.format != Marker::UNTEXTURED) {
+            let hash = *hash.get_or_insert_with(|| {
+                let address = memory.translate(loc_register(registers, REG_TEXTURE0_ADDRESS));
+                let len = texture_bytes(crate::texture::TextureFormat::from_raw(format), texture_width, texture_height, 1);
+                let mut bytes = vec![0; len];
+                memory.read(address, &mut bytes);
+                bytes.iter().fold(0xCBF2_9CE4_8422_2325u64, |hash, &byte| (hash ^ byte as u64).wrapping_mul(0x0000_0100_0000_01B3))
+            });
+            if hash != wanted {
+                continue;
+            }
+        }
+        if let Some(place) = marker.place {
+            let Some([left, top, right, bottom]) = span else { continue };
+            let within = |value: f32, [from, to]: [f32; 2]| (from..=to).contains(&value);
+            if !(within(left, place.left) && within(top, place.top) && within(right - left, place.width) && within(bottom - top, place.height)) {
+                continue;
+            }
+        }
+        return Some((marker.id, span));
+    }
+    None
+}
+
+/// the part of texture unit 0 a draw puts on the screen texel for pixel at
+/// the console's resolution, a picture shown as it is, a video's frame say,
+/// as its columns and rows from the top, from and to. drawn bigger, the
+/// pixels along its edges sample between its last texels and what lies past
+/// them in the texture, which at the console's resolution they never reach:
+/// a pixel's center is a texel's. none for anything else, a draw in
+/// perspective, scaled or turned, or past the texture's edges.
+fn blit_rect(vertices: &[Vertex], viewport: (f32, f32, f32, f32), (width, height): (u32, u32)) -> Option<[u32; 4]> {
+    // vertices land on a sixteenth of a pixel
+    const NEAR: f32 = 0.07;
+    let w = vertices.first()?.clip[3];
+    let mut points = Vec::with_capacity(vertices.len());
+    for vertex in vertices {
+        if (vertex.clip[3] - w).abs() > 1e-4 * w.abs().max(1.0) {
+            return None;
+        }
+        let screen = to_screen(vertex, viewport)?;
+        let [u, v] = vertex.texcoords[0];
+        points.push(([screen.x, screen.y], [u * width as f32, (1.0 - v) * height as f32]));
+    }
+    // each of the texture's axes along one of the screen's, a texel a pixel,
+    // either way, the screen turned against the picture or not
+    let follows = |texture: usize, screen: usize| {
+        let (start, from) = (points[0].0[screen], points[0].1[texture]);
+        [1.0f32, -1.0].iter().any(|way| points.iter().all(|(on, at)| (at[texture] - from - way * (on[screen] - start)).abs() < NEAR))
+    };
+    if !(follows(0, 0) && follows(1, 1)) && !(follows(0, 1) && follows(1, 0)) {
+        return None;
+    }
+    let span = |axis: usize| points.iter().fold((f32::MAX, f32::MIN), |(low, high), (_, at)| (low.min(at[axis]), high.max(at[axis])));
+    let ((left, right), (top, bottom)) = (span(0), span(1));
+    let whole = |c: f32, size: u32| ((c - c.round()).abs() < NEAR && c.round() >= 0.0 && c.round() <= size as f32).then_some(c.round() as u32);
+    let rect = [whole(left, width)?, whole(top, height)?, whole(right, width)?, whole(bottom, height)?];
+    (rect[2] > rect[0] && rect[3] > rect[1]).then_some(rect)
+}
+
+/// texels with the columns and rows just past rect, see blit_rect, copies
+/// of its edges, so that a sample drawn bigger at an edge mixes in what it
+/// would clamped to rect. past the texture's own edge they are where the
+/// unit wraps to, nothing when it clamps or mirrors. the largest size only,
+/// the smaller ones follow as they were.
+fn extend_edges(texels: &[[u8; 4]], (width, height): (u32, u32), [left, top, right, bottom]: [u32; 4], (wrap_s, wrap_t): (Wrap, Wrap)) -> Vec<[u8; 4]> {
+    let mut out = texels.to_vec();
+    // the column or row before from and after to, the slot wrapped to one
+    // that isn't the other's
+    let before = |from: u32, to: u32, size: u32, wrap: Wrap| match from {
+        0 if wrap == Wrap::Repeat && to + 1 < size => Some(size - 1),
+        0 => None,
+        _ => Some(from - 1),
+    };
+    let after = |from: u32, to: u32, size: u32, wrap: Wrap| match to {
+        _ if to < size => Some(to),
+        _ if wrap == Wrap::Repeat && from > 1 => Some(0),
+        _ => None,
+    };
+    let (first_column, last_column) = (before(left, right, width, wrap_s), after(left, right, width, wrap_s));
+    let (first_row, last_row) = (before(top, bottom, height, wrap_t), after(top, bottom, height, wrap_t));
+    let at = |column: u32, row: u32| row as usize * width as usize + column as usize;
+    for row in top..bottom {
+        if let Some(column) = first_column {
+            out[at(column, row)] = out[at(left, row)];
+        }
+        if let Some(column) = last_column {
+            out[at(column, row)] = out[at(right - 1, row)];
+        }
+    }
+    // the rows past across the columns past too, for the corners
+    for column in (left..right).chain(first_column).chain(last_column) {
+        if let Some(row) = first_row {
+            out[at(column, row)] = out[at(column, top)];
+        }
+        if let Some(row) = last_row {
+            out[at(column, row)] = out[at(column, bottom - 1)];
+        }
+    }
+    out
+}
+
+/// textures a draw showed part of texel for pixel, the rect of them, and
+/// the texels with its edges carried past it, see extend_edges, which the
+/// same picture shown again gets back, and with them the image the GPU
+/// made of them.
+#[derive(Default)]
+struct Edges(Vec<(Arc<[[u8; 4]]>, [u32; 4], Arc<[[u8; 4]]>)>);
+
+impl Edges {
+    const KEPT: usize = 32;
+
+    fn extended(&mut self, texture: &BoundTexture, rect: [u32; 4]) -> Arc<[[u8; 4]]> {
+        if let Some((_, _, texels)) = self.0.iter().find(|(source, kept, _)| Arc::ptr_eq(source, &texture.texels) && *kept == rect) {
+            return texels.clone();
+        }
+        // the ones whose texture the cache let go of first
+        self.0.retain(|(source, _, _)| Arc::strong_count(source) > 1);
+        if self.0.len() >= Self::KEPT {
+            self.0.remove(0);
+        }
+        let size = (texture.width, texture.height);
+        let texels: Arc<[[u8; 4]]> = extend_edges(&texture.texels, size, rect, (texture.wrap_s, texture.wrap_t)).into();
+        self.0.push((texture.texels.clone(), rect, texels.clone()));
+        texels
+    }
+}
