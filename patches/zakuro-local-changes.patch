+impl Place {
+    /// Whether the span, as the left, top, right and bottom edges, lies in these ranges.
+    fn contains(&self, [left, top, right, bottom]: [f32; 4]) -> bool {
+        let within = |value: f32, [from, to]: [f32; 2]| (from..=to).contains(&value);
