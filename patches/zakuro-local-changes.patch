+        let default = default_and_unit.next()?.parse().ok()?;
+        let unit = default_and_unit.collect::<Vec<_>>().join(" ");
+        Some(Setting { name: name.trim().to_owned(), min: min.parse().ok()?, max: max.parse().ok()?, default, unit })
+    }
