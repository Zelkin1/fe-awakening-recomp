+fn u16_at(d: &[u8], at: usize) -> Option<usize> {
+    Some(u16::from_le_bytes(d.get(at..at + 2)?.try_into().ok()?) as usize)
+}
+
+fn u32_at(d: &[u8], at: usize) -> Option<usize> {
+    Some(u32::from_le_bytes(d.get(at..at + 4)?.try_into().ok()?) as usize)
+}
+
+fn relative(d: &[u8], at: usize) -> Option<usize> {
+    let v = i32::from_le_bytes(d.get(at..at + 4)?.try_into().ok()?);
+    (v != 0).then(|| (at as i64 + v as i64) as usize)
+}
+
+pub fn textures_in(d: &[u8]) -> Vec<(usize, Texture)> {
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i + 8 <= d.len() {
+        match &d[i..i + 4] {
+            b"CTPK" => {
+                let count = u16_at(d, i + 6).unwrap_or(0);
+                let section = i + u32_at(d, i + 8).unwrap_or(0);
+                for t in 0..count.min(4096) {
+                    let e = i + 0x20 + t * 0x20;
+                    let (Some(off), Some(f), Some(w), Some(h)) = (u32_at(d, e + 8), u32_at(d, e + 12), u16_at(d, e + 16), u16_at(d, e + 18)) else { break };
+                    if let Some(tex) = texture(d, section + off, w, h, f as u32) {
+                        out.push((section + off, tex));
+                    }
+                }
+            }
+            b"TXOB" if i >= 4 => {
+                let t = i - 4;
+                if let (Some(h), Some(w), Some(f)) = (u32_at(d, t + 0x18), u32_at(d, t + 0x1C), u32_at(d, t + 0x34)) {
+                    if let Some(bits_at) = relative(d, t + 0x38).and_then(|image| relative(d, image + 0x0C)) {
+                        if let Some(tex) = texture(d, bits_at, w, h, f as u32) {
+                            out.push((bits_at, tex));
+                        }
+                    }
+                }
+            }
+            _ => {}
+        }
+        i += 4;
+    }
+    out
+}
+
+pub fn messages(d: &[u8]) -> HashMap<String, String> {
+    labelled(d).into_iter().collect()
+}
+
+pub fn labelled(d: &[u8]) -> Vec<(String, String)> {
+    let mut out = Vec::new();
+    let (Some(data_size), Some(pointers), Some(labels)) = (u32_at(d, 4), u32_at(d, 8), u32_at(d, 12)) else { return out };
+    let table = 0x20 + data_size + pointers * 4;
+    let names = table + labels * 8;
+    for i in 0..labels {
+        let (Some(text_at), Some(name_at)) = (u32_at(d, table + i * 8), u32_at(d, table + i * 8 + 4)) else { break };
+        let start_name = names + name_at;
+        let Some(end) = d.get(start_name..).and_then(|rest| rest.iter().position(|&b| b == 0)) else { continue };
+        let name: String = d[start_name..start_name + end].iter().map(|&b| if b.is_ascii() { b as char } else { '?' }).collect();
+        let start = 0x20 + text_at;
+        let mut stop = start;
+        while stop + 1 < d.len() && !(d[stop] == 0 && d[stop + 1] == 0) {
+            stop += 2;
+        }
+        let units: Vec<u16> = d[start..stop].as_chunks::<2>().0.iter().map(|&c| u16::from_le_bytes(c)).collect();
+        out.push((name, String::from_utf16_lossy(&units)));
+    }
+    out
+}
diff --git a/crates/zakuro/src/hdtext/sheets.rs b/crates/zakuro/src/hdtext/sheets.rs
new file mode 100644
index 0000000..f149df4
--- /dev/null
+++ b/crates/zakuro/src/hdtext/sheets.rs
@@ -0,0 +1,306 @@
+use std::cmp::Reverse;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::Mutex;
+
+use super::ops::{median_of, resize, Filter, Plane};
+use super::text::Face;
+
+const SCALE: usize = 4;
+const GAP: usize = 1;
+const RANGES: [(u32, u32); 6] = [(0x21, 0x7E), (0xA1, 0x17F), (0x2010, 0x2027), (0x2030, 0x203A), (0x20AC, 0x20AC), (0x2122, 0x2122)];
+
+#[derive(Clone, Copy)]
+pub struct Glyph {
+    pub code: u32,
+    pub sheet: usize,
+    pub x: usize,
+    pub y: usize,
+    pub w: usize,
+    pub h: usize,
+    pub left: i32,
+    pub top: i32,
+    pub advance: i32,
+}
+
+pub struct Bfnt {
+    pub width: usize,
+    pub height: usize,
+    pub glyphs: Vec<Glyph>,
+    pub sheets: Vec<usize>,
+    pub sheets_at: usize,
+}
+
+fn u16_at(d: &[u8], at: usize) -> usize {
+    u16::from_le_bytes([d[at], d[at + 1]]) as usize
+}
+
+pub fn parse(data: &[u8]) -> Option<Bfnt> {
+    if data.len() < 0x30 {
+        return None;
+    }
+    let (width, height) = (u16_at(data, 0x10), u16_at(data, 0x12));
+    let count = u16_at(data, 0x22);
+    let sheets_at = u32::from_le_bytes(data.get(0x24..0x28)?.try_into().ok()?) as usize;
+    let mut glyphs = Vec::with_capacity(count);
+    for i in 0..count {
+        let at = 0x30 + i * 16;
+        let e = data.get(at..at + 16)?;
+        glyphs.push(Glyph {
+            code: u16_at(e, 0) as u32,
+            sheet: u16_at(e, 2),
+            x: u16_at(e, 4),
+            y: u16_at(e, 6),
+            w: e[8] as usize,
+            h: e[9] as usize,
+            left: e[10] as i8 as i32,
+            top: e[11] as i8 as i32,
+            advance: e[12] as i8 as i32,
+        });
+    }
+    let size = width * height / 2;
+    let mut sheets = Vec::new();
+    let mut at = sheets_at;
+    while size > 0 && at + size <= data.len() {
+        sheets.push(at);
+        at += size;
+    }
+    Some(Bfnt { width, height, glyphs, sheets, sheets_at })
+}
+
+#[derive(Clone, Copy, PartialEq)]
+pub enum Measure {
+    Capitals,
+    Digits,
+}
+
+pub struct Style {
+    pub measure: Measure,
+    pub natural_space: bool,
+    pub keep_digit_advance: bool,
+}
+
+pub struct Redrawn {
+    pub file: Vec<u8>,
+    pub sheets: Vec<(u64, Plane)>,
+}
+
+fn wanted(code: u32) -> bool {
+    RANGES.iter().any(|&(low, high)| (low..=high).contains(&code))
+}
+
+fn cell_of(images: &[Plane], g: &Glyph) -> Plane {
+    images[g.sheet].crop(g.x, g.y, g.x + g.w, g.y + g.h)
+}
+
+fn ink_height(p: &Plane) -> f32 {
+    (0..p.h).map(|y| p.row_max(y)).sum()
+}
+
+fn soften(cell: &Plane) -> Plane {
+    let factor = SCALE * 4;
+    let up = resize(cell, cell.w * factor, cell.h * factor, Filter::Bicubic);
+    let shaped = up.map(|v| {
+        let x = ((v - 0.3) / 0.4).clamp(0.0, 1.0);
+        x * x * (3.0 - 2.0 * x)
+    });
+    shaped.down(4)
+}
+
+fn encode_a4(p: &Plane) -> Vec<u8> {
+    let mut out = vec![0u8; p.w * p.h / 2];
+    for y in 0..p.h {
+        for x in 0..p.w {
+            let nibble = (p.at(x, y).clamp(0.0, 1.0) * 15.0).round() as u8;
+            let bit = zakuro_gpu::format::morton_offset(x as u32, y as u32, p.w as u32, 4) as usize;
+            out[bit / 8] |= if bit.is_multiple_of(8) { nibble } else { nibble << 4 };
+        }
+    }
+    out
+}
+
+enum Kind {
+    Blank,
+    Vector(char),
+    Bitmap,
+}
+
+struct Made {
+    glyph: Glyph,
+    fine: Plane,
+    coarse: Plane,
+}
+
+fn vector(fine: &Face, c: char, shift: f32) -> Option<(i32, usize, usize, i32, Plane)> {
+    let (plane, ox, oy) = fine.placed(c, shift * SCALE as f32, 0.0)?;
+    let s = SCALE as f32;
+    let left = (ox as f32 / s).floor() as i32;
+    let right = ((ox + plane.w as i32) as f32 / s).ceil() as i32;
+    let top = (-oy as f32 / s).ceil() as i32;
+    let bottom = ((oy + plane.h as i32) as f32 / s).ceil() as i32;
+    let (w, h) = ((right - left).max(1) as usize, (top + bottom).max(1) as usize);
+    let mut picture = Plane::new(w * SCALE, h * SCALE);
+    picture.paste(&plane, (ox - left * SCALE as i32) as isize, (oy + top * SCALE as i32) as isize);
+    Some((left, w, h, top, picture))
+}
+
+fn bitmap(images: &[Plane], g: &Glyph) -> Plane {
+    let (x0, y0) = (g.x.saturating_sub(2), g.y.saturating_sub(2));
+    let (x1, y1) = ((g.x + g.w + 2).min(images[g.sheet].w), (g.y + g.h + 2).min(images[g.sheet].h));
+    let around = soften(&images[g.sheet].crop(x0, y0, x1, y1));
+    let (ox, oy) = ((g.x - x0) * SCALE, (g.y - y0) * SCALE);
+    around.crop(ox, oy, ox + g.w * SCALE, oy + g.h * SCALE)
+}
+
+fn pack(sizes: &[(usize, usize)], width: usize, height: usize, sheets: usize) -> Option<Vec<(usize, usize, usize)>> {
+    let mut order: Vec<usize> = (0..sizes.len()).collect();
+    order.sort_by_key(|&i| (Reverse(sizes[i].1), Reverse(sizes[i].0)));
+    let mut places = vec![(0, 0, 0); sizes.len()];
+    let (mut sheet, mut x, mut y, mut shelf) = (0, 0, 0, 0);
+    for i in order {
+        let (w, h) = sizes[i];
+        if x + w > width {
+            (x, y, shelf) = (0, y + shelf + GAP, 0);
+        }
+        if y + h > height {
+            (sheet, x, y, shelf) = (sheet + 1, 0, 0, 0);
+        }
+        if sheet >= sheets || w > width || h > height {
+            return None;
+        }
+        places[i] = (sheet, x, y);
+        x += w + GAP;
+        shelf = shelf.max(h);
+    }
+    Some(places)
+}
+
+pub fn redraw(face: &Face, data: &[u8], font: &Bfnt, images: &[Plane], style: &Style) -> Option<Redrawn> {
+    let by_code: HashMap<u32, Glyph> = font.glyphs.iter().map(|g| (g.code, *g)).collect();
+    let probe = face.sized(400.0);
+    let reference: Vec<char> = match style.measure {
+        Measure::Capitals => vec!['H'],
+        Measure::Digits => "0123456789".chars().collect(),
+    };
+    let mut originals: Vec<f32> = reference.iter().filter_map(|&c| by_code.get(&(c as u32))).filter(|g| g.sheet < images.len()).map(|g| ink_height(&cell_of(images, g))).filter(|&h| h > 0.0).collect();
+    let mut drawn: Vec<f32> = reference.iter().filter_map(|&c| probe.ink_box(c)).map(|(_, top, _, bottom)| bottom - top).collect();
+    if originals.is_empty() || drawn.is_empty() {
+        return None;
+    }
+    let mut em = 400.0 * median_of(&mut originals) / median_of(&mut drawn);
+    if style.measure == Measure::Capitals {
+        let tallest = by_code.get(&('É' as u32)).filter(|g| g.sheet < images.len()).map(|g| {
+            let cell = cell_of(images, g);
+            let first = (0..cell.h).find(|&y| cell.row_max(y) > 0.5).unwrap_or(0);
+            g.top as f32 - first as f32
+        });
+        if let (Some(room), Some((_, top, _, _))) = (tallest, probe.ink_box('É')) {
+            em = em.min(400.0 * (room + 0.5) / -top);
+        }
+    }
+    let face = probe.sized(em);
+    let fine = probe.sized(em * SCALE as f32);
+    let natural_digits = "0123456789".chars().filter(|&c| face.has(c)).map(|c| face.advance(c)).fold(0.0f32, f32::max).round() as i32;
+    let digit_advance = if style.keep_digit_advance { natural_digits.max(by_code.get(&('0' as u32)).map_or(0, |g| g.advance)) } else { natural_digits };
+    let kinds: Vec<Kind> = font
+        .glyphs
+        .iter()
+        .map(|g| {
+            if g.w == 0 || g.h == 0 || g.sheet >= images.len() {
+                return Kind::Blank;
+            }
+            let strongest = cell_of(images, g).max();
+            if strongest < 0.03 {
+                return Kind::Blank;
+            }
+            match char::from_u32(g.code) {
+                Some(c) if wanted(g.code) && face.has(c) && strongest >= 0.1 => Kind::Vector(c),
+                _ => Kind::Bitmap,
+            }
+        })
+        .collect();
+    let made: Mutex<Vec<Option<Made>>> = Mutex::new((0..font.glyphs.len()).map(|_| None).collect());
+    let next = AtomicUsize::new(0);
+    let workers = std::thread::available_parallelism().map_or(4, |n| n.get());
+    std::thread::scope(|scope| {
+        for _ in 0..workers {
+            scope.spawn(|| loop {
+                let i = next.fetch_add(1, Ordering::Relaxed);
+                let Some(g) = font.glyphs.get(i) else { break };
+                let one = match kinds[i] {
+                    Kind::Blank => {
+                        let mut glyph = *g;
+                        if style.natural_space && (g.code == 0x20 || g.code == 0xA0) {
+                            glyph.advance = face.spaced(' ').0.round() as i32;
+                        }
+                        Some(Made { glyph, fine: Plane::new(1, 1), coarse: Plane::new(1, 1) })
+                    }
+                    Kind::Vector(c) => {
+                        let (spaced, cut) = face.spaced(c);
+                        let (advance, shift) = if c.is_ascii_digit() {
+                            (digit_advance, (digit_advance as f32 - face.advance(c)) / 2.0)
+                        } else {
+                            let advance = spaced.round().max(1.0) as i32;
+                            (advance, (advance as f32 - spaced) / 2.0 - cut)
+                        };
+                        vector(&fine, c, shift).map(|(left, w, h, top, picture)| Made {
+                            glyph: Glyph { w, h, left, top, advance, ..*g },
+                            coarse: picture.down(SCALE),
+                            fine: picture,
+                        })
+                    }
+                    Kind::Bitmap => Some(Made { glyph: *g, fine: bitmap(images, g), coarse: cell_of(images, g) }),
+                };
+                made.lock().unwrap()[i] = one;
+            });
+        }
+    });
+    let mut made: Vec<Made> = made.into_inner().unwrap().into_iter().collect::<Option<Vec<Made>>>()?;
+    if made.iter().any(|m| m.glyph.w > 255 || m.glyph.h > 255 || [m.glyph.left, m.glyph.top, m.glyph.advance].iter().any(|v| !(-128..=127).contains(v))) {
+        return None;
+    }
+    let blank = made.iter().zip(&kinds).filter(|(_, k)| matches!(k, Kind::Blank)).fold((1, 1), |(w, h), (m, _)| (m.glyph.w.max(w), m.glyph.h.max(h)));
+    let inked: Vec<usize> = (0..made.len()).filter(|&i| !matches!(kinds[i], Kind::Blank)).collect();
+    let mut sizes: Vec<(usize, usize)> = vec![blank];
+    sizes.extend(inked.iter().map(|&i| (made[i].glyph.w, made[i].glyph.h)));
+    let places = pack(&sizes, font.width, font.height, font.sheets.len())?;
+    let mut fine_sheets: Vec<Plane> = (0..font.sheets.len()).map(|_| Plane::new(font.width * SCALE, font.height * SCALE)).collect();
+    let mut coarse_sheets: Vec<Plane> = (0..font.sheets.len()).map(|_| Plane::new(font.width, font.height)).collect();
+    for (m, k) in made.iter_mut().zip(&kinds) {
+        if matches!(k, Kind::Blank) {
+            (m.glyph.sheet, m.glyph.x, m.glyph.y) = places[0];
+        }
+    }
+    for (slot, &i) in inked.iter().enumerate() {
+        let (sheet, x, y) = places[slot + 1];
+        let m = &mut made[i];
+        (m.glyph.sheet, m.glyph.x, m.glyph.y) = (sheet, x, y);
+        fine_sheets[sheet].paste(&m.fine, (x * SCALE) as isize, (y * SCALE) as isize);
+        coarse_sheets[sheet].paste(&m.coarse, x as isize, y as isize);
+    }
+    let mut file = data[..font.sheets_at].to_vec();
+    for (i, m) in made.iter().enumerate() {
+        let g = &m.glyph;
+        let at = 0x30 + i * 16;
+        file[at..at + 2].copy_from_slice(&(g.code as u16).to_le_bytes());
+        file[at + 2..at + 4].copy_from_slice(&(g.sheet as u16).to_le_bytes());
+        file[at + 4..at + 6].copy_from_slice(&(g.x as u16).to_le_bytes());
+        file[at + 6..at + 8].copy_from_slice(&(g.y as u16).to_le_bytes());
+        file[at + 8] = g.w as u8;
+        file[at + 9] = g.h as u8;
+        file[at + 10] = g.left as i8 as u8;
+        file[at + 11] = g.top as i8 as u8;
+        file[at + 12] = g.advance as i8 as u8;
+        file[at + 13] = 0;
+    }
+    let mut sheets = Vec::with_capacity(coarse_sheets.len());
+    for (coarse, fine) in coarse_sheets.iter().zip(fine_sheets) {
+        let encoded = encode_a4(coarse);
+        sheets.push((cityhasher::hash(&encoded), fine));
+        file.extend_from_slice(&encoded);
+    }
+    if file.len() < data.len() {
+        file.extend_from_slice(&data[file.len()..]);
+    }
+    Some(Redrawn { file, sheets })
+}
diff --git a/crates/zakuro/src/hdtext/text.rs b/crates/zakuro/src/hdtext/text.rs
new file mode 100644
index 0000000..5cf752b
--- /dev/null
+++ b/crates/zakuro/src/hdtext/text.rs
@@ -0,0 +1,158 @@
+use ab_glyph::{point, Font, FontRef, GlyphId, PxScale, ScaleFont};
+
+use super::ops::Plane;
+
+const TRIM: f32 = 0.02;
+const MIN_BEARING: f32 = 0.025;
+const WORD_SPACING: f32 = 0.06;
+
+#[derive(Clone)]
+pub struct Face {
+    pub font: FontRef<'static>,
+    pub em: f32,
+    figures: Option<u16>,
+    slant: f32,
+}
+
+pub struct Raster {
+    pub plane: Plane,
+    pub left: f32,
+    pub top: f32,
+}
+
+impl Face {
+    pub fn new(bytes: &'static [u8], em: f32) -> Face {
+        Face { font: FontRef::try_from_slice(bytes).expect("a bundled font"), em, figures: None, slant: 0.0 }
+    }
+
+    pub fn slanted(&self, slant: f32) -> Face {
+        Face { slant, ..self.clone() }
+    }
+
+    pub fn with_figures(self, first: u16) -> Face {
+        Face { figures: Some(first), ..self }
+    }
+
+    pub fn sized(&self, em: f32) -> Face {
+        Face { em, ..self.clone() }
+    }
+
+    fn scale(&self) -> PxScale {
+        let units = self.font.units_per_em().unwrap_or(1000.0);
+        PxScale::from(self.em * self.font.height_unscaled() / units)
+    }
+
+    pub fn has(&self, c: char) -> bool {
+        let id = self.id(c);
+        id.0 != 0 && self.font.outline(id).is_some()
+    }
+
+    fn id(&self, c: char) -> GlyphId {
+        match (self.figures, c.to_digit(10)) {
+            (Some(first), Some(digit)) => GlyphId(first + digit as u16),
+            _ => self.font.glyph_id(c),
+        }
+    }
+
+    pub fn advance(&self, c: char) -> f32 {
+        self.font.as_scaled(self.scale()).h_advance(self.id(c))
+    }
+
+    pub fn spaced(&self, c: char) -> (f32, f32) {
+        let advance = self.advance(c);
+        if c.is_whitespace() {
+            return (advance + (WORD_SPACING + 2.0 * TRIM) * self.em, 0.0);
+        }
+        let Some(outline) = self.font.outline(self.id(c)) else { return (advance, 0.0) };
+        let per = self.em / self.font.units_per_em().unwrap_or(1000.0);
+        let trim = |bearing: f32| (bearing - MIN_BEARING * self.em).clamp(0.0, TRIM * self.em);
+        let (left, right) = (trim(outline.bounds.min.x * per), trim(advance - outline.bounds.max.x * per));
+        (advance - left - right, left)
+    }
+
+    pub fn kern(&self, a: char, b: char) -> f32 {
+        self.font.as_scaled(self.scale()).kern(self.id(a), self.id(b))
+    }
+
+    pub fn glyph(&self, c: char) -> Option<Raster> {
+        let (plane, left, top) = self.placed(c, 0.0, 0.0)?;
+        Some(Raster { plane, left: left as f32, top: top as f32 })
+    }
+
+    pub fn placed(&self, c: char, x: f32, y: f32) -> Option<(Plane, i32, i32)> {
+        let glyph = self.id(c).with_scale_and_position(self.scale(), point(x, y));
+        let outlined = self.font.outline_glyph(glyph)?;
+        let bounds = outlined.px_bounds();
+        let (w, h) = ((bounds.width() as usize).max(1), (bounds.height() as usize).max(1));
+        let mut plane = Plane::new(w, h);
+        outlined.draw(|px, py, coverage| {
+            let (px, py) = (px as usize, py as usize);
+            if px < w && py < h {
+                plane.v[py * w + px] = coverage.min(1.0);
+            }
+        });
+        Some((plane, bounds.min.x as i32, bounds.min.y as i32))
+    }
+
+    pub fn ink_box(&self, c: char) -> Option<(f32, f32, f32, f32)> {
+        let glyph = self.id(c).with_scale_and_position(self.scale(), point(0.0, 0.0));
+        let b = self.font.outline_glyph(glyph)?.px_bounds();
+        Some((b.min.x, b.min.y, b.max.x, b.max.y))
+    }
+
+    pub fn line(&self, text: &str, tracking: f32) -> Option<Plane> {
+        let chars: Vec<char> = text.chars().collect();
+        let mut pens = Vec::with_capacity(chars.len());
+        let mut pen = 0.0f32;
+        for (i, &c) in chars.iter().enumerate() {
+            if i > 0 {
+                pen += self.kern(chars[i - 1], c) + tracking * self.em;
+            }
+            let (advance, shift) = self.spaced(c);
+            pens.push(pen - shift);
+            pen += advance;
+        }
+        let rasters: Vec<(f32, Raster)> = chars.iter().zip(&pens).filter_map(|(&c, &x)| Some((x, self.glyph(c)?))).collect();
+        if rasters.is_empty() {
+            return None;
+        }
+        let x0 = rasters.iter().map(|(x, r)| x + r.left).fold(f32::INFINITY, f32::min).floor();
+        let y0 = rasters.iter().map(|(_, r)| r.top).fold(f32::INFINITY, f32::min).floor();
+        let x1 = rasters.iter().map(|(x, r)| x + r.left + r.plane.w as f32).fold(f32::NEG_INFINITY, f32::max).ceil();
+        let y1 = rasters.iter().map(|(_, r)| r.top + r.plane.h as f32).fold(f32::NEG_INFINITY, f32::max).ceil();
+        let mut out = Plane::new((x1 - x0) as usize + 1, (y1 - y0) as usize + 1);
+        for (x, r) in &rasters {
+            let ox = (x + r.left - x0).round() as usize;
+            let oy = (r.top - y0).round() as usize;
+            for yy in 0..r.plane.h {
+                for xx in 0..r.plane.w {
+                    let (tx, ty) = (ox + xx, oy + yy);
+                    if tx < out.w && ty < out.h {
+                        let v = &mut out.v[ty * out.w + tx];
+                        *v = v.max(r.plane.v[yy * r.plane.w + xx]);
+                    }
+                }
+            }
+        }
+        let out = if self.slant > 0.0 { sheared(&out, self.slant) } else { out };
+        let (bx0, bx1, by0, by1) = out.bbox(0.5)?;
+        Some(out.crop(bx0, by0, bx1, by1))
+    }
+}
+
+fn sheared(p: &Plane, slant: f32) -> Plane {
+    let extra = (p.h as f32 * slant).ceil() as usize;
+    let mut out = Plane::new(p.w + extra, p.h);
+    for y in 0..p.h {
+        let shift = (p.h - 1 - y) as f32 * slant;
+        let (whole, part) = (shift.floor() as usize, shift.fract());
+        for x in 0..p.w {
+            let v = p.at(x, y);
+            out.v[y * out.w + x + whole] += v * (1.0 - part);
+            if x + whole + 1 < out.w {
+                out.v[y * out.w + x + whole + 1] += v * part;
+            }
+        }
+    }
+    out
+}
diff --git a/crates/zakuro/src/hdtext/titles.rs b/crates/zakuro/src/hdtext/titles.rs
new file mode 100644
index 0000000..dce1550
--- /dev/null
+++ b/crates/zakuro/src/hdtext/titles.rs
@@ -0,0 +1,192 @@
+use std::collections::HashMap;
+
+use super::ops::{luminance, median_colour, resize, Filter, Mask, Plane, Rgba};
+use super::text::Face;
+
+pub const SS: usize = 8;
+pub const SCALE: usize = 4;
+const SEARCH: usize = 4;
+
+pub fn split_lines(alpha: &Plane, threshold: f32) -> Vec<(usize, usize)> {
+    let mut spans = Vec::new();
+    let mut start = None;
+    for y in 0..=alpha.h {
+        let on = y < alpha.h && alpha.row_max(y) > threshold;
+        match (on, start) {
+            (true, None) => start = Some(y),
+            (false, Some(s)) => {
+                spans.push((s, y));
+                start = None;
+            }
+            _ => {}
+        }
+    }
+    spans
+}
+
+pub struct Search {
+    pub factors: (f32, f32, f32),
+    pub wanted: (f32, f32),
+    pub stretch: (f32, f32),
+    pub overshoot: f32,
+    pub lifts: (f32, f32, f32),
+    pub room: Option<f32>,
+    pub edge: f32,
+}
+
+pub const TITLE: Search = Search { factors: (0.72, 1.121, 0.03), wanted: (0.7, 1.45), stretch: (0.8, 1.2), overshoot: f32::INFINITY, lifts: (-2.0, 2.01, 0.5), room: Some(1.5), edge: 1.0 };
+
+pub struct Fit {
+    pub error: f32,
+    pub scale: f32,
+    pub stretch: f32,
+    pub dy: f32,
+}
+
+fn steps((start, end, step): (f32, f32, f32)) -> Vec<f32> {
+    let mut out = Vec::new();
+    let mut v = start;
+    while v <= end {
+        out.push(v);
+        v += step;
+    }
+    out
+}
+
+fn origin(core: &Plane, b: (usize, usize, usize, usize), size: (usize, usize), dy: f32, ss: usize) -> Option<(usize, usize)> {
+    let (x0, x1, by0, by1) = b;
+    let (sw, sh) = size;
+    let ox = (((x0 + x1) as f32 / 2.0 * ss as f32 - sw as f32 / 2.0).round() as isize).clamp(0, (core.w * ss) as isize - sw as isize);
+    let oy = (((by0 + by1) as f32 / 2.0 + dy) * ss as f32 - sh as f32 / 2.0).round() as isize;
+    (oy >= 0 && oy as usize + sh <= core.h * ss && ox >= 0).then_some((ox as usize, oy as usize))
+}
+
+pub fn search(mask: &Plane, core: &Plane, rows: (usize, usize), b: (usize, usize, usize, usize), s: &Search) -> Option<Fit> {
+    let (r0, r1) = rows;
+    let base = (b.3 - b.2) as f32 * SS as f32 / mask.h as f32;
+    let top = base * s.factors.1;
+    let small_h = ((mask.h as f32 * top * SEARCH as f32 / SS as f32).round() as usize).max(4);
+    let small_w = ((mask.w as f32 * small_h as f32 / mask.h as f32).round() as usize).max(1);
+    let small = resize(mask, small_w, small_h, Filter::Lanczos);
+    let target = core.crop(0, r0, core.w, r1);
+    let target_energy: f32 = target.v.iter().map(|t| t * t).sum();
+    let mut best: Option<Fit> = None;
+    let mut grid = vec![0.0f32; target.v.len()];
+    for factor in steps(s.factors) {
+        let scale = base * factor;
+        let wanted = (b.1 - b.0) as f32 * SS as f32 / (mask.w as f32 * scale);
+        if wanted < s.wanted.0 || wanted > s.wanted.1 {
+            continue;
+        }
+        let stretch = wanted.clamp(s.stretch.0, s.stretch.1).min(wanted * s.overshoot).min(s.room.map_or(f32::INFINITY, |room| (core.w as f32 - room) * SS as f32 / (mask.w as f32 * scale)));
+        let sw = ((mask.w as f32 * scale * stretch * SEARCH as f32 / SS as f32).round() as usize).max(1);
+        let sh = ((mask.h as f32 * scale * SEARCH as f32 / SS as f32).round() as usize).max(1);
+        if sw as f32 > (core.w as f32 - s.edge) * SEARCH as f32 {
+            continue;
+        }
+        let fitted = resize(&small, sw, sh, Filter::Lanczos);
+        for dy in steps(s.lifts) {
+            let Some((ox, oy)) = origin(core, b, (sw, sh), dy, SEARCH) else { continue };
+            grid.iter_mut().for_each(|g| *g = 0.0);
+            for j in 0..sh {
+                let y = (oy + j) / SEARCH;
+                if y < r0 || y >= r1 {
+                    continue;
+                }
+                let row = &mut grid[(y - r0) * core.w..(y - r0 + 1) * core.w];
+                for (i, v) in fitted.v[j * sw..(j + 1) * sw].iter().enumerate() {
+                    row[(ox + i) / SEARCH] += v;
+                }
+            }
+            let norm = 1.0 / (SEARCH * SEARCH) as f32;
+            let (mut dot, mut energy) = (0.0f32, target_energy);
+            for (g, t) in grid.iter().zip(&target.v) {
+                let g = g * norm;
+                dot += g * t;
+                energy += g * g;
+            }
+            let error = 1.0 - 2.0 * dot / energy.max(1e-6);
+            if best.as_ref().is_none_or(|f| error < f.error) {
+                best = Some(Fit { error, scale, stretch, dy });
+            }
+        }
+    }
+    best
+}
+
+pub fn place(mask: &Plane, core: &Plane, b: (usize, usize, usize, usize), fit: &Fit, ss: usize, edge: f32) -> Option<Plane> {
+    let sw = ((mask.w as f32 * fit.scale * fit.stretch * ss as f32 / SS as f32).round() as usize).max(1);
+    let sh = ((mask.h as f32 * fit.scale * ss as f32 / SS as f32).round() as usize).max(1);
+    if sw as f32 > (core.w as f32 - edge) * ss as f32 {
+        return None;
+    }
+    let (ox, oy) = origin(core, b, (sw, sh), fit.dy, ss)?;
+    let fitted = resize(mask, sw, sh, Filter::Lanczos).map(|v| v.clamp(0.0, 1.0));
+    let mut canvas = Plane::new(core.w * ss, core.h * ss);
+    canvas.paste(&fitted, ox as isize, oy as isize);
+    Some(canvas)
+}
+
+fn core_of(image: &Rgba, glow: [f32; 3]) -> Plane {
+    let glow_lum = luminance(glow).max(1e-3);
+    Plane { w: image.w, h: image.h, v: image.v.iter().map(|p| (p[3] * (1.0 - luminance([p[0], p[1], p[2]]) / glow_lum)).clamp(0.0, 1.0)).collect() }
+}
+
+fn glow_colour(image: &Rgba) -> [f32; 3] {
+    let halo = Mask { w: image.w, h: image.h, v: image.v.iter().map(|p| p[3] > 0.2 && p[3] < 0.8).collect() };
+    if halo.count() > 20 { median_colour(image, &halo).map(|c| [c[0], c[1], c[2]]).unwrap_or([1.0; 3]) } else { [1.0; 3] }
+}
+
+pub fn redraw(image: &Rgba, texts: &[String], face: &Face) -> Option<Rgba> {
+    let glow = glow_colour(image);
+    let core = core_of(image, glow);
+    let alpha = image.channel(3);
+    let lines: Vec<(usize, usize)> = split_lines(&alpha, 0.3).into_iter().filter(|s| s.1 - s.0 >= 4).collect();
+    if lines.len() != texts.len() {
+        return None;
+    }
+    let probe = face.sized(40.0 * SS as f32);
+    let mut big = Plane::new(image.w * SCALE, image.h * SCALE);
+    for (text, &(y0, y1)) in texts.iter().zip(&lines) {
+        let band = core.crop(0, y0, core.w, y1);
+        let (x0, x1, by0, by1) = band.bbox(0.5)?;
+        let b = (x0, x1, by0 + y0, by1 + y0);
+        let mask = probe.line(text, 0.0)?;
+        let fit = search(&mask, &core, (y0, y1), b, &TITLE)?;
+        let canvas = place(&mask, &core, b, &fit, SCALE, TITLE.edge)?;
+        for (b, f) in big.v.iter_mut().zip(&canvas.v) {
+            *b = b.max(*f);
+        }
+    }
+    Some(super::banners::redraw(image, &core, super::banners::Kind::Plain, super::banners::Tone { share: 1.0, grey: 1.0 }, &big))
+}
+
+pub fn texts(messages: &HashMap<String, String>, name: &str, lang: char, places: &[(char, &str, &str)], names: &[(char, &str, &str)]) -> Option<Vec<String>> {
+    let encounter = name.starts_with('B');
+    let rest = name.trim_start_matches('B');
+    let digits = rest.trim_start_matches(['P', 'X']);
+    if digits.len() != 3 || !digits.chars().all(|c| c.is_ascii_digit()) {
+        return None;
+    }
+    if encounter {
+        let place = places.iter().find(|(l, n, _)| *l == lang && *n == name).map(|(_, _, p)| p.to_string()).or_else(|| messages.get(&format!("MCID_T_{rest}")).cloned())?;
+        let first = messages.get("MCID_ENCOUNT_T")?.clone();
+        return Some(vec![first, if lang == 'I' { place } else { format!("- {place} -") }]);
+    }
+    let mut first = messages.get(&format!("MCID_{rest}_T"))?.clone();
+    let mut second = messages.get(&format!("MCID_{rest}"))?.clone();
+    if let Some((_, _, n)) = names.iter().find(|(l, n, _)| *l == lang && *n == rest) {
+        second = n.to_string();
+    }
+    if lang == 'S' {
+        if let Some(r) = first.strip_prefix("Cap. ") {
+            first = format!("Capítulo {r}");
+        }
+    }
+    if lang == 'G' {
+        if let Some(r) = first.strip_prefix("Nq. ") {
+            first = format!("Nebenquest {r}");
+        }
+    }
+    Some(vec![first, second])
+}
