+/// the pixels of a rectangle of the bottom screen's picture, RGBA 320 by
+/// 240 at the console's resolution, that aren't the ground around what it
+/// shows, as runs along its rows: the row, the first pixel and one past
+/// the last, in the screen's pixels. none for a picture of another size.
+pub fn cut_out(picture: &[u8], rect: [u16; 4], ground: Ground) -> Vec<[u16; 3]> {
+    let [left, top, width, height] = rect.map(usize::from);
+    if picture.len() < 320 * 240 * 4 || left + width > 320 || top + height > 240 || width == 0 || height == 0 {
+        return Vec::new();
+    }
+    let is_ground = |x: usize, y: usize| {
+        let at = ((top + y) * 320 + left + x) * 4;
+        let [r, g, b] = [picture[at], picture[at + 1], picture[at + 2]].map(u16::from);
+        r > g + ground.redder as u16 && r + g + b < ground.darker
+    };
+    // the ground joined to the top and the sides, four ways
+    let mut outside = vec![false; width * height];
+    let mut stack: Vec<(usize, usize)> = (0..width).map(|x| (x, 0)).chain((0..height).flat_map(|y| [(0, y), (width - 1, y)])).collect();
+    while let Some((x, y)) = stack.pop() {
+        if outside[y * width + x] || !is_ground(x, y) {
+            continue;
+        }
+        outside[y * width + x] = true;
+        if x > 0 {
+            stack.push((x - 1, y));
+        }
+        if x + 1 < width {
+            stack.push((x + 1, y));
+        }
+        if y > 0 {
+            stack.push((x, y - 1));
+        }
+        if y + 1 < height {
+            stack.push((x, y + 1));
+        }
+    }
+    let mut runs = Vec::new();
+    for y in 0..height {
+        let mut x = 0;
+        while x < width {
+            if outside[y * width + x] {
+                x += 1;
+                continue;
+            }
+            let from = x;
+            while x < width && !outside[y * width + x] {
+                x += 1;
+            }
+            runs.push([(top + y) as u16, (left + from) as u16, (left + x) as u16]);
+        }
+    }
+    runs
+}
