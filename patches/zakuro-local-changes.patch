+    fn paint(ctx: &egui::Context, size: [u32; 2], pointer: Option<[f32; 2]>, mut run: impl FnMut(&mut egui::Ui)) -> image::RgbaImage {
+        use egui::epaint::{ClippedPrimitive, Primitive};
+        use std::collections::HashMap;
+        let zoom = 1.5;
+        ctx.set_zoom_factor(zoom);
+        // windows fade in over time, which these frames don't have
