+fn bounds_of(p: &Plane, threshold: f32) -> Option<(isize, isize, isize, isize)> {
+    let (r0, r1) = p.rows_above(threshold)?;
+    let (c0, c1) = p.cols_above(threshold)?;
+    Some((c0 as isize, c1 as isize, r0 as isize, r1 as isize))
+}
