+/// the frame rate as the corner shows it: the pictures the game draws a
+/// second, then, while frame interpolation draws pictures in between, the
+/// ones the top screen shows, 30/60 say.
+fn frame_rate((own, between): (f32, f32)) -> String {
+    if between >= 0.5 {
+        format!("{own:.0}/{:.0} FPS", own + between)
+    } else {
+        format!("{own:.0} FPS")
+    }
