+        assert!(!pointer.shown);
+        pointer.steer([1.0, 1.0], start + Duration::from_millis(40));
+        assert!(pointer.shown);
+        assert!(pointer.at[0] > 160.0 && pointer.at[1] < 120.0);
+        for step in 2..200 {
+            pointer.steer([1.0, 0.0], start + Duration::from_millis(40 * step));
