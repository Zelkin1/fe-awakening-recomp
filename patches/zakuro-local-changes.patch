+        (system.cursor_on_unit(), "the cursor on a unit"),
+        (system.unit_selected(), "a unit chosen"),
+        (system.talking(), "a dialogue"),
+        (system.world_map(), "the world map"),
+        (system.forecast(), "a forecast"),
+        (system.brief_forecast(), "a brief forecast"),
+        (system.battle_pieces().is_some(), "a battle"),
+        (system.title_pieces().is_some(), "the title screen"),
+        (system.world_pieces().is_some(), "the world map's parts of the bottom screen"),
+        (system.unit_view(), "a unit's 3D view"),
+    ];
+    for (_, scene) in scenes.iter().filter(|(shown, _)| *shown) {
+        println!("frame {frame}: {scene}");
+    }
+    for (id, [left, top, ..]) in system.marker_spans() {
+        if id == zakuro_core::LEFT_BANNER || id == zakuro_core::RIGHT_BANNER {
+            println!("frame {frame}: banner {id} at {:.1} {:.1}", left * 320.0, top * 240.0);
+        }
+    }
+}
