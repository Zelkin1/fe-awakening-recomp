@@ -0,0 +1,220 @@
+//! the second look of a battle's panels over the 3D, see settings::BattleUi:
+//! each fighter's name on a banner, the HP in a diamond by a long bar, the
+//! weapon on a band and the stats as tabs over boxes, drawn from shapes of
+//! the frontend's own, with the game's own text taken off the ground it lies
+//! on in the bottom screen's picture at the console's resolution, which the
+//! GPU smooths drawing it bigger as it does the game's own text.
+
+use zakuro_gpu::{BannerSide, Banners};
+
+const WIDTH: usize = 320;
+const HEIGHT: usize = 240;
+
+/// a piece of the bottom screen's text off its ground: RGBA, not
+/// premultiplied, its width and height in the console's pixels, and the
+/// ground's colour, which what it goes on is painted in.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Text {
+    pub size: [usize; 2],
+    pub rgba: Vec<u8>,
+    pub ground: [u8; 3],
+}
+
+/// what one fighter's panels show: name, HP, weapon, and Atk, Hit and Crit
+/// from the top, and how full its HP gauge is.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Side {
+    pub name: Text,
+    pub hp: Text,
+    pub weapon: Text,
+    pub values: [Text; 3],
+    pub fraction: f32,
+}
+
+/// both fighters', the left one first, and the stats' labels between them.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Read {
+    pub sides: [Side; 2],
+    pub labels: [Text; 3],
+}
+
+fn pixel(picture: &[u8], x: usize, y: usize) -> [u8; 3] {
+    let at = (y * WIDTH + x) * 4;
+    [picture[at], picture[at + 1], picture[at + 2]]
+}
+
+/// the rectangle moved by moved and kept on the screen, as pixel ranges.
+fn ranges([left, top, width, height]: [u16; 4], [dx, dy]: [i32; 2]) -> (std::ops::Range<usize>, std::ops::Range<usize>) {
+    let clamp = |value: i32, most: usize| value.clamp(0, most as i32) as usize;
+    let (x0, y0) = (clamp(left as i32 + dx, WIDTH), clamp(top as i32 + dy, HEIGHT));
+    let (x1, y1) = (clamp(left as i32 + width as i32 + dx, WIDTH), clamp(top as i32 + height as i32 + dy, HEIGHT));
+    (x0..x1, y0..y1)
+}
+
+/// the colour most of a rectangle's pixels are, near enough: the mean of
+/// those in the commonest of colours an eighth of the range wide.
+pub fn ground(picture: &[u8], rect: [u16; 4], moved: [i32; 2]) -> [u8; 3] {
+    let (xs, ys) = ranges(rect, moved);
+    let mut counts: std::collections::HashMap<[u8; 3], (u32, [u32; 3])> = std::collections::HashMap::new();
+    for y in ys {
+        for x in xs.clone() {
+            let c = pixel(picture, x, y);
+            let entry = counts.entry(c.map(|v| v / 32)).or_default();
+            entry.0 += 1;
+            for i in 0..3 {
+                entry.1[i] += c[i] as u32;
+            }
+        }
+    }
+    counts.values().max_by_key(|(count, _)| *count).map_or([0; 3], |&(count, sum)| sum.map(|v| (v / count.max(1)) as u8))
+}
+
+/// a rectangle's pixels off their ground: how far each is from the ground's
+/// colour, against how far the farthest is, is how much of it is text, its
+/// colour what is left once the ground's share of it is taken out, so that
+/// drawn over the ground's colour it is the game's pixel again. a rectangle
+/// with nothing far from its ground is clear.
+pub fn text(picture: &[u8], rect: [u16; 4], moved: [i32; 2], ground: [u8; 3]) -> Text {
+    let (xs, ys) = ranges(rect, moved);
+    let size = [xs.len(), ys.len()];
+    let g = ground.map(f32::from);
+    let far = |x: usize, y: usize| {
+        let c = pixel(picture, x, y).map(f32::from);
+        (0..3).map(|i| (c[i] - g[i]).abs()).fold(0.0, f32::max)
+    };
+    let top = ys.clone().flat_map(|y| xs.clone().map(move |x| (x, y))).map(|(x, y)| far(x, y)).fold(0.0, f32::max);
+    const NEAR: f32 = 12.0;
+    let mut rgba = Vec::with_capacity(size[0] * size[1] * 4);
+    for y in ys {
+        for x in xs.clone() {
+            let c = pixel(picture, x, y).map(f32::from);
+            let alpha = if top < 40.0 { 0.0 } else { ((far(x, y) - NEAR) / (top - NEAR)).clamp(0.0, 1.0) };
+            let color = if alpha > 0.0 { [0, 1, 2].map(|i| ((c[i] - g[i] * (1.0 - alpha)) / alpha).clamp(0.0, 255.0) as u8) } else { [0; 3] };
+            rgba.extend_from_slice(&[color[0], color[1], color[2], (alpha * 255.0).round() as u8]);
+        }
+    }
+    trimmed(Text { size, rgba, ground })
+}
+
+/// the text without the clear rows and columns round it, so that it is
+/// placed by what it shows.
+fn trimmed(text: Text) -> Text {
+    let [width, height] = text.size;
+    let seen = |x: usize, y: usize| text.rgba[(y * width + x) * 4 + 3] > 8;
+    let columns: Vec<usize> = (0..width).filter(|&x| (0..height).any(|y| seen(x, y))).collect();
+    let rows: Vec<usize> = (0..height).filter(|&y| (0..width).any(|x| seen(x, y))).collect();
+    let (Some(&x0), Some(&x1), Some(&y0), Some(&y1)) = (columns.first(), columns.last(), rows.first(), rows.last()) else {
+        return Text { size: [0, 0], rgba: Vec::new(), ground: text.ground };
+    };
+    let mut rgba = Vec::with_capacity((x1 - x0 + 1) * (y1 - y0 + 1) * 4);
+    for y in y0..=y1 {
+        rgba.extend_from_slice(&text.rgba[(y * width + x0) * 4..(y * width + x1 + 1) * 4]);
+    }
+    Text { size: [x1 - x0 + 1, y1 - y0 + 1], rgba, ground: text.ground }
+}
+
+/// how full a gauge of segments is: the lit ones in its brightest row over
+/// all of them in the rows about it, where the unlit ones show too.
+pub fn fraction(picture: &[u8], rect: [u16; 4], moved: [i32; 2]) -> f32 {
+    let (xs, ys) = ranges(rect, moved);
+    let light = |x: usize, y: usize| {
+        let [r, g, b] = pixel(picture, x, y).map(f32::from);
+        0.299 * r + 0.587 * g + 0.114 * b
+    };
+    // the runs of pixels brighter than level along a row
+    let runs = |y: usize, level: f32| {
+        let mut count = 0;
+        let mut inside = false;
+        for x in xs.clone() {
+            let on = light(x, y) > level;
+            count += (on && !inside) as u32;
+            inside = on;
+        }
+        count
+    };
+    let Some(best) = ys.clone().max_by_key(|&y| runs(y, 150.0)) else { return 0.0 };
+    let lit = runs(best, 150.0);
+    let all = ys.filter(|y| y.abs_diff(best) <= 6).map(|y| runs(y, 50.0)).max().unwrap_or(0);
+    if all == 0 { 0.0 } else { (lit as f32 / all as f32).min(1.0) }
+}
+
+/// how far the game moved a side's panels, shaking them as its fighter is
+/// hit, from where the marker they move with was drawn, a few pixels at most.
+fn moved(side: &BannerSide, spans: &[(u32, [f32; 4])]) -> [i32; 2] {
+    let Some((id, [rest_x, rest_y])) = side.follows else { return [0, 0] };
+    let Some(&(_, [x, y, ..])) = spans.iter().find(|&&(marked, _)| marked == id) else { return [0, 0] };
+    [((x * WIDTH as f32) - rest_x as f32).round().clamp(-14.0, 14.0) as i32, ((y * HEIGHT as f32) - rest_y as f32).round().clamp(-9.0, 9.0) as i32]
+}
+
+/// what the battle's panels show in the bottom screen's picture, RGBA 320
+/// by 240 at the console's resolution; none for a picture of another size.
+pub fn read(picture: &[u8], banners: &Banners, spans: &[(u32, [f32; 4])]) -> Option<Read> {
+    if picture.len() < WIDTH * HEIGHT * 4 {
+        return None;
+    }
+    let side = |side: &BannerSide| {
+        let by = moved(side, spans);
+        let taken = |rect: [u16; 4]| text(picture, rect, by, ground(picture, rect, by));
+        Side {
+            name: taken(side.name),
+            hp: taken(side.hp),
+            weapon: taken(side.weapon),
+            values: side.values.map(taken),
+            fraction: fraction(picture, side.gauge, by),
+        }
+    };
+    let labels = banners.labels.map(|rect| text(picture, rect, [0, 0], ground(picture, rect, [0, 0])));
+    Some(Read { sides: [side(&banners.sides[0]), side(&banners.sides[1])], labels })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn picture(ground: [u8; 3]) -> Vec<u8> {
+        let mut picture = vec![255u8; WIDTH * HEIGHT * 4];
+        for chunk in picture.chunks_mut(4) {
+            chunk[..3].copy_from_slice(&ground);
+        }
+        picture
+    }
+
+    fn put(picture: &mut [u8], x: usize, y: usize, rgb: [u8; 3]) {
+        picture[(y * WIDTH + x) * 4..][..3].copy_from_slice(&rgb);
+    }
+
+    /// text on its ground comes off it whole, trimmed to what shows, a pixel
+    /// half of each its colour on its own again, half seen.
+    #[test]
+    fn text_comes_off_its_ground() {
+        let navy = [10, 18, 34];
+        let mut picture = picture(navy);
+        put(&mut picture, 11, 21, [230, 220, 180]);
+        put(&mut picture, 12, 21, [120, 119, 107]);
+        let found = ground(&picture, [10, 20, 4, 3], [0, 0]);
+        assert_eq!(found, navy);
+        let text = text(&picture, [10, 20, 4, 3], [0, 0], found);
+        assert_eq!(text.size, [2, 1], "trimmed to what shows");
+        let at = |x: usize, y: usize| &text.rgba[(y * 2 + x) * 4..][..4];
+        assert_eq!(at(0, 0), [230, 220, 180, 255]);
+        let half = at(1, 0);
+        assert!((half[3] as i32 - 120).abs() <= 2, "{half:?}");
+        assert!(half[0] > 200, "its own colour again, {half:?}");
+    }
+
+    /// a gauge of three-pixel segments, the lit ones bright on top and all
+    /// of them dimmer under, is as full as its lit share.
+    #[test]
+    fn a_gauge_is_as_full_as_its_lit_segments() {
+        let mut picture = picture([10, 18, 34]);
+        for segment in 0..10 {
+            for dx in 0..2 {
+                let x = 40 + segment * 3 + dx;
+                put(&mut picture, x, 33, if segment < 7 { [217, 217, 81] } else { [10, 18, 34] });
+                put(&mut picture, x, 36, [78, 78, 10]);
+            }
+        }
+        let full = fraction(&picture, [38, 30, 40, 10], [0, 0]);
+        assert!((full - 0.7).abs() < 1e-6, "{full}");
+    }
+}
