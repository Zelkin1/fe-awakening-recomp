+
+pub type Box4 = [usize; 4];
+
+pub const PRESS_ANY_BUTTON_BOX: Box4 = [44, 0, 212, 32];
+pub const PRESS_ANY_BUTTON_KEEP: [Box4; 2] = [[0, 0, 47, 32], [211, 0, 256, 32]];
