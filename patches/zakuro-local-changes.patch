+        *kept = None;
+        return false;
+    }
+    if !moved_on {
+        return true;
+    }
+    if opens && talking && (touched_lately || *kept == Some(scene)) {
+        *kept = Some(scene);
+        return true;
+    }
+    *kept = None;
+    false
+}
