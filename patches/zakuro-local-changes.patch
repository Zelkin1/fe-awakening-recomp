+fn shadow(edge: f32, color: Color32) -> egui::epaint::Shadow {
+    let points = |value: f32| value.round().clamp(0.0, 255.0) as u8;
+    egui::epaint::Shadow { offset: [0, 0], blur: points(edge * 1.5), spread: points(edge / 2.0), color }
+}
