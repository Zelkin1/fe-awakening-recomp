+        let cores = std::thread::available_parallelism().map_or(2, |cores| cores.get());
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(cores)
+            .thread_name(|index| format!("texture decoder {index}"))
+            .build()
+            .expect("threads to decode textures on")
+    })
+}
