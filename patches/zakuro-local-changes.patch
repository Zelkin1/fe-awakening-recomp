+                let bottom = (pa.1.max(pb.1).max(pc.1).min(clip[3]).min(height as f32).ceil() as usize).min(height);
+                for y in top..bottom {
+                    for x in left..right {
+                        let (px, py) = (x as f32 + 0.5, y as f32 + 0.5);
+                        if px < clip[0] || px >= clip[2] || py < clip[1] || py >= clip[3] {
+                            continue;
+                        }
