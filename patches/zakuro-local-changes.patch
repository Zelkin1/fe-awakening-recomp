+pub(crate) fn keeps_bottom_over(moved_on: bool, opens: bool, talking: bool, touched_lately: bool, scene: Scene, kept: &mut Option<Scene>) -> bool {
+    if kept.is_some() && !talking {
+        *kept = None;
+        return false;
+    }
+    if !moved_on {
+        return true;
+    }
+    if opens && talking && (touched_lately || *kept == Some(scene)) {
+        *kept = Some(scene);
+        return true;
+    }
+    *kept = None;
+    false
+}
