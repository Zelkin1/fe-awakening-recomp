+        let primitives: Vec<ClippedPrimitive> = ctx.tessellate(output.shapes, ppp);
+        let (width, height) = (size[0] as usize, size[1] as usize);
+        let mut out = vec![[0x20u8, 0x18, 0x10, 255]; width * height];
