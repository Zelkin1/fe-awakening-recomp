+fn extend_edges(texels: &[[u8; 4]], (width, height): (u32, u32), [left, top, right, bottom]: [u32; 4], (wrap_s, wrap_t): (Wrap, Wrap)) -> Vec<[u8; 4]> {
+    let mut extended = texels.to_vec();
+    let before = |from: u32, to: u32, size: u32, wrap: Wrap| match from {
+        0 if wrap == Wrap::Repeat && to + 1 < size => Some(size - 1),
+        0 => None,
+        _ => Some(from - 1),
+    };
+    let after = |from: u32, to: u32, size: u32, wrap: Wrap| match to {
+        _ if to < size => Some(to),
+        _ if wrap == Wrap::Repeat && from > 1 => Some(0),
+        _ => None,
+    };
+    let (column_before, column_after) = (before(left, right, width, wrap_s), after(left, right, width, wrap_s));
+    let (row_before, row_after) = (before(top, bottom, height, wrap_t), after(top, bottom, height, wrap_t));
+    let index = |column: u32, row: u32| row as usize * width as usize + column as usize;
+    for row in top..bottom {
+        if let Some(column) = column_before {
+            extended[index(column, row)] = extended[index(left, row)];
+        }
+        if let Some(column) = column_after {
+            extended[index(column, row)] = extended[index(right - 1, row)];
+        }
+    }
+    for column in (left..right).chain(column_before).chain(column_after) {
+        if let Some(row) = row_before {
+            extended[index(column, row)] = extended[index(column, top)];
+        }
+        if let Some(row) = row_after {
+            extended[index(column, row)] = extended[index(column, bottom - 1)];
+        }
+    }
+    extended
+}
