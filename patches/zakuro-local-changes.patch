+        lines += &format!("{i} {x} {y} {z} {w}\n");
+    }
+    if let Ok(mut file) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = std::io::Write::write_all(&mut file, lines.as_bytes());
+    }
