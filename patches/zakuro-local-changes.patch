+pub struct Place {
+    /// The range of the left edge.
+    pub left: [f32; 2],
+    /// The range of the top edge.
+    pub top: [f32; 2],
+    /// The range of the width.
+    pub width: [f32; 2],
+    /// The range of the height.
+    pub height: [f32; 2],
