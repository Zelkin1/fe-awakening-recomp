+/// the rectangle GPUREG_SCISSORTEST_MODE keeps a draw inside of, set in
+/// GPUREG_SCISSORTEST_POS and _DIM, from and to (past) in x and y, the way
+/// the viewport has them, none when it is off. a game clips with it, the
+/// text of Awakening's dialogue boxes as it scrolls up. keeping a draw out
+/// of the rectangle instead isn't followed, the draw goes everywhere.
+fn scissor(registers: &[u32]) -> Option<[i32; 4]> {
+    let (from, to) = (registers[REG_SCISSOR_FROM], registers[REG_SCISSOR_TO]);
+    let corner = |at: u32| [(at & 0x3FF) as i32, (at >> 16 & 0x3FF) as i32];
+    let ([from_x, from_y], [to_x, to_y]) = (corner(from), corner(to));
+    match registers[REG_SCISSOR_MODE] & 3 {
+        // its last column and row inside it too
+        3 => Some([from_x, from_y, to_x + 1, to_y + 1]),
+        1 => {
+            static SAID: std::sync::Once = std::sync::Once::new();
+            SAID.call_once(|| log::warn!("a draw keeps out of a scissor rectangle, which isn't followed"));
+            None
+        }
+        _ => None,
+    }
+}
