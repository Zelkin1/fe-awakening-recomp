             let krate = if path.join("crates/zakuro/Cargo.toml").exists() { path.join("crates/zakuro") } else { path };
-            format!("{{ path = \"{}\" }}", krate.display())
+            format!("{{ path = \"{}\" }}", toml_path(&krate))
         }
         None => format!("{{ git = \"{ZAKURO}\" }}"),
     };
