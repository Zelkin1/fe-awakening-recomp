@@ -31,7 +31,7 @@ pub struct ModStep {
 }
 
 /// the mods the launcher builds, each with its game.
-pub const MOD_STEPS: &[ModStep] = &[];
+pub const MOD_STEPS: &[ModStep] = &[crate::feet::STEP];
 
 /// the mods built with the game of program_id.
 pub fn mod_steps(program_id: u64) -> impl Iterator<Item = &'static ModStep> {
