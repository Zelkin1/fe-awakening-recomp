+
+mod foot;
+mod formats;
+mod model;
+
+use std::collections::BTreeSet;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::Mutex;
+
+use crate::recompile::ModStep;
+
+pub const PROGRAM_ID: u64 = 0x0004_0000_0009_F100;
+
+pub const STEP: ModStep = ModStep { name: "the feet mod", program_id: PROGRAM_ID, build };
+
+pub fn folder(data_dir: &Path) -> PathBuf {
+    zakuro_core::mods::dir(data_dir, PROGRAM_ID).join("feet")
+}
+
+fn bodies(romfs: &zakuro_fs::romfs::RomFs) -> Result<Vec<String>, String> {
+    let mut dir = romfs.root().map_err(|error| error.to_string())?;
+    if let Some((_, nameless)) = romfs.subdirs(&dir).into_iter().find(|(_, d)| d.name.is_empty()) {
+        dir = nameless;
+    }
+    let (_, b) = romfs.subdirs(&dir).into_iter().find(|(_, d)| d.name == "b").ok_or("the game has no b folder")?;
+    let mut names: Vec<String> =
+        romfs.files(&b).into_iter().map(|(_, file)| file.name).filter(|name| name.starts_with("uBody_") && name.ends_with(".m.lz")).collect();
+    names.sort();
+    Ok(names)
+}
+
+fn build(rom: &Path, data_dir: &Path, progress: &(dyn Fn(usize, usize) + Sync), cancel: &AtomicBool) -> Result<String, String> {
+    let title = zakuro_fs::Title::load(rom).map_err(|error| format!("{}: {error}", rom.display()))?;
+    if title.program_id() != PROGRAM_ID {
+        return Err("the feet are made for the European release".into());
+    }
+    let romfs = title.romfs.as_ref().ok_or("the game has no RomFS")?;
+    let bodies = bodies(romfs)?;
+    let out = folder(data_dir).join("romfs").join("b");
+    std::fs::create_dir_all(&out).map_err(|error| format!("{}: {error}", out.display()))?;
+    let read = |name: &str| -> Option<Vec<u8>> {
+        let file = romfs.lookup(&format!("b/{name}")).ok()?;
+        formats::unpack(title.read_romfs(&file, 0, file.data_size as usize)?).ok()
+    };
+    let one = |name: &str| -> Result<&'static str, String> {
+        let model = read(name).ok_or("its file can't be read")?;
+        let texture = read(&name.replace(".m.lz", "_c0.t.lz")).and_then(|file| foot::colour_texture(&file));
+        let (bytes, style) = foot::build(&format!("b/{name}"), &model, texture.as_ref())?;
+        let path = out.join(name);
+        std::fs::write(&path, formats::lz13(&bytes)).map_err(|error| format!("{}: {error}", path.display()))?;
+        Ok(style)
+    };
+    let (next, done, results) = (AtomicUsize::new(0), AtomicUsize::new(0), Mutex::new(Vec::new()));
+    let workers = std::thread::available_parallelism().map_or(4, |n| n.get()).min(bodies.len()).max(1);
+    progress(0, bodies.len());
+    std::thread::scope(|scope| {
+        for _ in 0..workers {
+            scope.spawn(|| loop {
+                let i = next.fetch_add(1, Ordering::Relaxed);
+                if i >= bodies.len() || cancel.load(Ordering::Relaxed) {
+                    break;
+                }
+                let result = one(&bodies[i]);
+                results.lock().unwrap().push((bodies[i].clone(), result));
+                progress(done.fetch_add(1, Ordering::Relaxed) + 1, bodies.len());
+            });
+        }
+    });
+    if cancel.load(Ordering::Relaxed) {
+        return Err("cancelled".into());
+    }
+    let mut results = results.into_inner().unwrap();
+    results.sort_by(|a, b| a.0.cmp(&b.0));
+    let made: BTreeSet<&str> = results.iter().filter(|(_, result)| result.is_ok()).map(|(name, _)| name.as_str()).collect();
+    for (name, result) in &results {
+        match result {
+            Ok(style) => log::info!("feet: {name}, a {style}"),
+            Err(error) => log::info!("feet: {name} keeps the game's legs, {error}"),
+        }
+    }
+    for entry in std::fs::read_dir(&out).into_iter().flatten().flatten() {
+        let name = entry.file_name().to_string_lossy().into_owned();
+        if name.starts_with("uBody_") && name.ends_with(".m.lz") && !made.contains(name.as_str()) {
+            let _ = std::fs::remove_file(entry.path());
+        }
+    }
+    if made.is_empty() {
+        return Err("no body could be given feet".into());
+    }
+    Ok(format!("feet for {} of the {} bodies", made.len(), bodies.len()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    #[ignore]
+    fn the_whole_game() {
+        let (Ok(rom), Ok(data)) = (std::env::var("ZAKURO_FEET_ROM"), std::env::var("ZAKURO_FEET_DATA")) else {
+            panic!("set ZAKURO_FEET_ROM and ZAKURO_FEET_DATA");
+        };
+        let started = std::time::Instant::now();
+        let said = build(Path::new(&rom), Path::new(&data), &|_, _| {}, &AtomicBool::new(false)).unwrap();
+        println!("{said} in {:.1} s", started.elapsed().as_secs_f64());
+    }
+}
diff --git a/crates/zakuro/src/feet/model.rs b/crates/zakuro/src/feet/model.rs
new file mode 100644
index 0000000..562ad05
--- /dev/null
+++ b/crates/zakuro/src/feet/model.rs
@@ -0,0 +1,133 @@
+
+use std::collections::HashMap;
+
+use super::formats::Blob;
+
+pub const FLOAT: u32 = 0x1406;
+const SHORT: u32 = 0x1402;
+const UBYTE: u32 = 0x1401;
+const BYTE: u32 = 0x1400;
+const SHORT_INDICES: u32 = 0x1403;
+pub const POSITION: u32 = 0;
+pub const NORMAL: u32 = 1;
+pub const UV: u32 = 4;
+pub const BONES: u32 = 7;
+pub const WEIGHTS: u32 = 8;
+
+pub fn width(format: u32) -> Result<usize, String> {
+    match format {
+        FLOAT => Ok(4),
+        SHORT => Ok(2),
+        UBYTE | BYTE => Ok(1),
+        _ => Err(format!("a vertex format 0x{format:X} this doesn't read")),
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+pub struct Attr {
+    pub format: u32,
+    pub count: usize,
+    pub scale: f64,
+    pub offset: usize,
+}
+
+pub struct Vertices {
+    pub position: Vec<[f64; 3]>,
+    pub uv: Option<Vec<[f64; 2]>>,
+    pub bones: Option<Vec<Vec<i64>>>,
+    pub weights: Option<Vec<Vec<f64>>>,
+    pub stride: usize,
+    pub attrs: HashMap<u32, Attr>,
+    pub count: usize,
+    pub data_at: usize,
+    pub size: usize,
+    pub buffer: usize,
+}
+
+pub struct SubMesh {
+    pub palette: Vec<u32>,
+    pub triangles: Vec<[usize; 3]>,
+}
+
+pub fn parts(b: &Blob) -> Result<(usize, usize, usize), String> {
+    if b.0.get(0..4) != Some(b"CGFX") {
+        return Err("not a CGFX file".into());
+    }
+    let models = b.dict(b.rel(b.u16(6) as usize + 12))?;
+    let model = models.first().ok_or("no model")?.1;
+    Ok((model, b.to(model + 0xE0)?, b.to(b.to(model + 0xC8)?)?))
+}
+
+pub fn vertices(b: &Blob, shape: usize) -> Result<Vertices, String> {
+    let buffer = b.to(b.to(shape + 0x3C)?)?;
+    let (size, data_at, stride) = (b.u32(buffer + 0x14) as usize, b.to(buffer + 0x18)?, b.u32(buffer + 0x24) as usize);
+    let mut attrs = HashMap::new();
+    let list = b.to(buffer + 0x2C)?;
+    for i in 0..b.u32(buffer + 0x28) as usize {
+        let at = b.to(list + 4 * i)?;
+        let attr = Attr { format: b.u32(at + 36), count: b.u32(at + 40) as usize, scale: b.f32(at + 44), offset: b.u32(at + 48) as usize };
+        attrs.insert(b.u32(at + 4), attr);
+    }
+    if stride == 0 || data_at + size > b.0.len() {
+        return Err("a vertex buffer outside its file".into());
+    }
+    let count = size / stride;
+    let take = |usage: u32| -> Result<Option<Vec<Vec<f64>>>, String> {
+        let Some(attr) = attrs.get(&usage) else { return Ok(None) };
+        let w = width(attr.format)?;
+        let values = (0..count)
+            .map(|i| {
+                (0..attr.count)
+                    .map(|c| {
+                        let at = data_at + i * stride + attr.offset + w * c;
+                        let value = match attr.format {
+                            FLOAT => b.f32(at),
+                            SHORT => b.u16(at) as i16 as f64,
+                            UBYTE => b.0[at] as f64,
+                            _ => b.0[at] as i8 as f64,
+                        };
+                        value * attr.scale
+                    })
+                    .collect()
+            })
+            .collect();
+        Ok(Some(values))
+    };
+    let position = take(POSITION)?.ok_or("no positions")?.into_iter().map(|p| [p[0], p[1], p[2]]).collect();
+    let uv = take(UV)?.map(|uv| uv.into_iter().map(|t| [t[0], t[1]]).collect());
+    let bones = take(BONES)?.map(|bones| bones.into_iter().map(|row| row.into_iter().map(|v| v as i64).collect()).collect());
+    Ok(Vertices { position, uv, bones, weights: take(WEIGHTS)?, stride, attrs, count, data_at, size, buffer })
+}
+
+pub fn submeshes(b: &Blob, shape: usize) -> Result<Vec<SubMesh>, String> {
+    let list = b.to(shape + 0x30)?;
+    let mut out = Vec::new();
+    for i in 0..b.u32(shape + 0x2C) as usize {
+        let sm = b.to(list + 4 * i)?;
+        let count = b.u32(sm) as usize;
+        let palette = match count {
+            0 => Vec::new(),
+            _ => {
+                let at = b.to(sm + 4)?;
+                (0..count).map(|k| b.u32(at + 4 * k)).collect()
+            }
+        };
+        let mut triangles = Vec::new();
+        let faces = b.rel(sm + 0x10);
+        for f in 0..b.u32(sm + 0x0C) as usize {
+            let face = b.to(faces.ok_or("no faces")? + 4 * f)?;
+            let descs = b.rel(face + 4);
+            for d in 0..b.u32(face) as usize {
+                let desc = b.to(descs.ok_or("no index streams")? + 4 * d)?;
+                let (format, size, data) = (b.u32(desc), b.u32(desc + 8) as usize, b.to(desc + 12)?);
+                let indices: Vec<usize> = match format {
+                    SHORT_INDICES => (0..size / 2).map(|k| b.u16(data + 2 * k) as usize).collect(),
+                    _ => b.0[data..data + size].iter().map(|&i| i as usize).collect(),
+                };
+                triangles.extend(indices.chunks_exact(3).map(|t| [t[0], t[1], t[2]]));
+            }
+        }
+        out.push(SubMesh { palette, triangles });
+    }
+    Ok(out)
+}
