 }
 
+/// what a call to a function with a hook runs: the hook, then the game's
+/// code unless the hook did its work, in which case it returns to the
+/// caller as that code would have.
+unsafe extern "C" fn hooked(ctx: *mut Context) {
+    unsafe {
+        let machine = machine(ctx);
+        let address = (*ctx).r[15];
+        let hook = machine.library.hooks.iter().find(|(at, _)| *at == address).map(|&(_, hook)| hook);
+        if hook.is_some_and(|hook| !hook(machine.memory, &mut *ctx)) {
+            let back = (*ctx).r[14];
+            (*ctx).thumb = (back & 1) as u8;
+            (*ctx).r[15] = back & if back & 1 != 0 { !1 } else { !3 };
+            return;
+        }
+        match machine.library.code.lookup(address) {
+            Some(code) => code(ctx),
+            None => (*ctx).exit = EXIT_UNWIND,
+        }
+    }
+}
