+    hooks: Vec<(u32, Hook)>,
+}
+
+pub type Hook = fn(&mut Memory, &mut Context) -> AfterHook;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum AfterHook {
+    RunOriginal,
+    ReturnToCaller,
