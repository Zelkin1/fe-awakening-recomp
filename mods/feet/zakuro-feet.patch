+/// the plate classes and those whose legs end bare or strapped, by the code
+/// in their bodies' names, uBody_<sex>_<class>_<n>; the rest wear shoes.
+const SABATONS: [&str; 13] = ["karm", "gene", "kgre", "kgri", "kpal", "kdar", "kdr1", "kdr2", "lod2", "snyp", "war2", "ksoc", "merc"];
+const SANDALS: [&str; 5] = ["dmag", "sorc", "lagz", "baba", "swd2"];
