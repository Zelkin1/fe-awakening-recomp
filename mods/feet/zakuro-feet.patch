@@ -0,0 +1,1246 @@
+//! gives a body model feet of our own: a foot shape lofted from
+//! cross-sections in front of each leg's end, fitted to the leg's shaft, and
+//! written into the model's CGFX as a primitive set of its own, skinned to
+//! two bones added to the skeleton for it, a foot bone under each shin: the
+//! vertices appended to the shape's vertex buffer, the triangles, the set,
+//! the bones and the skeleton's dictionary with them at the end of the file.
+//! each foot bone is marked for Zakuro's feet hook (zakuro-core feet.rs),
+//! which turns it every frame so that the foot meets the floor: its flags
+//! have the game compute it a skinning matrix, and its inverse bind matrix,
+//! which only that would read, holds the foot's points instead, the ankle it
+//! turns about, the toe and the heel, then "FEET".
+//!
+//! the feet take the plainest rectangles of the shins' own texels, at the
+//! shins' texel density, from the body's colour texture; without one they
+//! take the nearest boot vertex's coordinates.
+
+use std::collections::{BTreeMap, BTreeSet, HashMap};
+
+use super::formats::{self, Blob, Image};
+use super::model::{self, Attr, FLOAT};
+
+type V3 = [f64; 3];
+
+fn add(a: V3, b: V3) -> V3 {
+    [a[0] + b[0], a[1] + b[1], a[2] + b[2]]
+}
+
+fn sub(a: V3, b: V3) -> V3 {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+
+fn mul(a: V3, s: f64) -> V3 {
+    [a[0] * s, a[1] * s, a[2] * s]
+}
+
+fn dot(a: V3, b: V3) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+fn cross(a: V3, b: V3) -> V3 {
+    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+}
+
+fn norm(a: V3) -> f64 {
+    dot(a, a).sqrt()
+}
+
+/// the smallest and the largest of points, each coordinate apart.
+fn bounds(points: impl Iterator<Item = V3>) -> (V3, V3) {
+    points.fold(([f64::INFINITY; 3], [f64::NEG_INFINITY; 3]), |(lo, hi), p| {
+        ([lo[0].min(p[0]), lo[1].min(p[1]), lo[2].min(p[2])], [hi[0].max(p[0]), hi[1].max(p[1]), hi[2].max(p[2])])
+    })
+}
+
+fn median(values: &mut [f64]) -> f64 {
+    values.sort_by(f64::total_cmp);
+    let n = values.len();
+    if n % 2 == 1 { values[n / 2] } else { (values[n / 2 - 1] + values[n / 2]) / 2.0 }
+}
+
+/// the q-th percentile, between the two nearest values as numpy's is.
+fn percentile(values: &mut [f64], q: f64) -> f64 {
+    values.sort_by(f64::total_cmp);
+    let at = (values.len() - 1) as f64 * q / 100.0;
+    let (low, share) = (at.floor() as usize, at - at.floor());
+    match values.get(low + 1) {
+        Some(&next) => values[low] + (next - values[low]) * share,
+        None => values[low],
+    }
+}
+
+// how far behind the leg's back the heel goes, as a share of the foot's
+// length, a real heel's, and the foot's length: Robin's for the depth of his
+// shaft, within shares of the knee's height, so that a thin leg doesn't get
+// a doll's foot nor a thick greave a clown's
+const HEEL: f64 = 0.03;
+const LENGTH_PER_DEPTH: f64 = 2.35;
+const LENGTH: (f64, f64) = (0.42, 0.60);
+const AHEAD_LEAST: f64 = 0.40;
+// the shaft a foot is fitted to, as shares of the knee's height above the
+// floor, where Robin's boots are straight; how much of a vertex's weight is
+// the shin's for it to be the leg's own, which leaves out robes, whose
+// vertices go with several bones
+const BAND: (f64, f64) = (0.234, 0.338);
+const OWN: f64 = 0.85;
+// below this share of the knee's height a leg's vertices are its end, whose
+// footprint tells the leg from a robe's hem hanging on the shin
+const END: f64 = 0.12;
+// above this share of the ankle's height the leg shows above the shoe
+const SHOWN: f64 = 0.85;
+// the widest a foot's shaft is taken to be, as a share of the knee's
+// height; Robin's is 0.19
+const WIDEST: f64 = 0.21;
+// how many texels each of a foot's vertices is nudged by at most, a noise
+// that mottles the leg's grain across the foot
+const NOISE: f64 = 1.5;
+// the boot's own end, below LOW of the ankle's height, made a straight boot
+// inside the foot, up to TUCK of the ankle's height
+const LOW: f64 = 0.25;
+const TUCK: f64 = 0.40;
+// how far above the floor a sole stands where it meets it, so that the
+// floor doesn't flicker through it
+const LIFT: f64 = 0.01;
+// the bone flags the game computes a skinning matrix for, the inverse bind
+// matrix in a bone's record, and the tag after the foot's points there
+const SKINNED: u32 = 0x240;
+const INVERSE_BIND: usize = 0xA4;
+const TAG: &[u8; 4] = b"FEET";
+
+/// a style of foot, fitting the legs it goes on: a shoe for boots of leather
+/// or cloth, a sabaton for plate, wider, its top in steps like plates over a
+/// thin sole, and a sandal for bare and strapped legs, a low bare foot on a
+/// thin sole. each is its cross-sections from heel to toe in two runs:
+/// behind the leg's front, where along the foot as a share of its length
+/// from the heel, and ahead of it, as a share of the way from the leg's
+/// front to the toe, so that the instep is always where the leg comes down
+/// into the foot. for each, the half-width as a share of the shaft's, as
+/// shares of the ankle's height the top of the upper, the top of the sole
+/// and its bottom, which rises at the toe, and where the upper's sides turn
+/// to its top, as a share of the half-width. then the angle in degrees under
+/// which faces share their normals, so that the foot is lit smoothly between
+/// its edges and its edges stay sharp.
+pub struct Style {
+    pub name: &'static str,
+    behind: &'static [[f64; 6]],
+    ahead: &'static [[f64; 6]],
+    smooth: f64,
+}
+
