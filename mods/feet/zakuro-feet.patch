+/// host code a call from recompiled code to one of the game's functions
+/// runs first, with the registers and memory as the call finds them. it
+/// says whether the game's own code runs after it, which it doesn't when the
+/// hook did that work itself: the call then returns to the caller from it.
+/// a call the interpreter makes skips it.
+pub type Hook = fn(&mut Memory, &mut Context) -> bool;
+
