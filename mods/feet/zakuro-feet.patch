+/// the host code a game's recompiled code runs on some of its calls, see
+/// recompiled::Hook: for Awakening's build it was written for, the ankles a
+/// mod gave feet, which stay dormant without such a mod, see feet.
+fn hook(library: &mut crate::recompiled::Library, program_id: u64, build: &str) {
+    if program_id == 0x0004_0000_0009_F100 && build == "rev0" {
+        library.hook(crate::feet::PRODUCT, crate::feet::skinning);
+    }
+}
