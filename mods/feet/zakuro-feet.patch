+
+    #[test]
+    fn classes_have_their_styles() {
+        assert_eq!(style_of("b/uBody_M_kgre_9.m.lz").name, "sabaton");
+        assert_eq!(style_of("b/uBody_F_sorc_0.m.lz").name, "sandal");
+        assert_eq!(style_of("b/uBody_M_mymM_0.m.lz").name, "shoe");
